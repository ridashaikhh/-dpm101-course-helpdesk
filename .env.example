# Copy to .env (local) or set in the Render dashboard. NEVER commit real keys.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Thinking budget for 2.5-flash (0 = off, fastest). Leave empty for models that don't support it.
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_S=15
GEMINI_MAX_RETRIES=1
GEMINI_MAX_CONCURRENCY=4
# SQLite file (cache + counters). On Render's free tier this is ephemeral.
DB_PATH=./data/helpdesk.db
RATE_LIMIT_PER_MIN=30
